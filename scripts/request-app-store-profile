#!/bin/zsh

set -euo pipefail

project_root=${0:A:h:h}
helper_root="$project_root/scripts/app-store-provisioning"
profile_dir="$project_root/src-tauri/appstore"
profile_path="$profile_dir/FIPSMonitor.provisionprofile"
provision_tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/fips-monitor-provisioning.XXXXXX")

cleanup() {
  if [[ -n "${provision_tmp_dir:-}" && -d "$provision_tmp_dir" ]]; then
    rm -rf "$provision_tmp_dir"
  fi
}
trap cleanup EXIT

if ! command -v xcodegen >/dev/null 2>&1; then
  print -u2 "xcodegen is required to request an Xcode-managed profile."
  print -u2 "Install it with: brew install xcodegen"
  exit 1
fi

mkdir -p "$provision_tmp_dir/project"

PROVISIONING_HELPER_ROOT="$helper_root" xcodegen \
  --spec "$helper_root/project.yml" \
  --project "$provision_tmp_dir/project" \
  --project-root "$helper_root"

xcodebuild \
  -project "$provision_tmp_dir/project/FIPSMonitorProvisioning.xcodeproj" \
  -scheme ProvisioningHelper \
  -configuration Release \
  -destination 'generic/platform=macOS' \
  -derivedDataPath "$provision_tmp_dir/DerivedData" \
  -archivePath "$provision_tmp_dir/FIPSMonitorProvisioning.xcarchive" \
  -allowProvisioningUpdates \
  archive

xcodebuild \
  -exportArchive \
  -archivePath "$provision_tmp_dir/FIPSMonitorProvisioning.xcarchive" \
  -exportPath "$provision_tmp_dir/export" \
  -exportOptionsPlist "$helper_root/ExportOptions.plist" \
  -allowProvisioningUpdates

exported_pkg=("$provision_tmp_dir"/export/*.pkg(N))
if (( ${#exported_pkg} != 1 )); then
  print -u2 "Expected one exported App Store package, found ${#exported_pkg}."
  exit 1
fi

pkgutil --expand-full "$exported_pkg[1]" "$provision_tmp_dir/expanded"
exported_profiles=("$provision_tmp_dir"/expanded/**/embedded.provisionprofile(N))
if (( ${#exported_profiles} != 1 )); then
  print -u2 "Expected one embedded provisioning profile, found ${#exported_profiles}."
  exit 1
fi

mkdir -p "$profile_dir"
cp "$exported_profiles[1]" "$profile_path"

profile_team=$(security cms -D -i "$profile_path" | plutil -extract TeamIdentifier.0 raw -o - -)
profile_app_id=$(security cms -D -i "$profile_path" | python3 -c 'import plistlib, sys; print(plistlib.loads(sys.stdin.buffer.read())["Entitlements"]["com.apple.application-identifier"])')

if [[ "$profile_team" != "8Z6Q2LZ77W" ]]; then
  print -u2 "Generated profile has unexpected team: $profile_team"
  exit 1
fi

if [[ "$profile_app_id" != "8Z6Q2LZ77W.com.paper-robin.fips-monitor" ]]; then
  print -u2 "Generated profile has unexpected application identifier: $profile_app_id"
  exit 1
fi

print "Installed Xcode-managed profile at $profile_path"
