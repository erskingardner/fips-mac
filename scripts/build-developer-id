#!/bin/zsh

set -euo pipefail

project_root=${0:A:h:h}
if (( ! $+commands[rustup] )); then
  print -u2 "rustup is required for the Developer ID build."
  exit 1
fi
rustup_bin=${commands[rustup]:A:h}
export PATH="$rustup_bin:$PATH"
export RUSTUP_TOOLCHAIN=${RUSTUP_TOOLCHAIN:-stable}
target=${FIPS_MAC_BUILD_TARGET:-universal-apple-darwin}
installer_identity=${APPLE_INSTALLER_SIGNING_IDENTITY:-}
if [[ -z "$installer_identity" ]]; then
  installer_identity=$(security find-identity -v -p basic 2>/dev/null \
    | awk -F'"' '/Developer ID Installer:.*\(8Z6Q2LZ77W\)/ { print $2; exit }')
fi
if [[ -z "$installer_identity" ]]; then
  print -u2 "A Paper Robin Developer ID Installer certificate is required for a release build."
  print -u2 "Import it or set APPLE_INSTALLER_SIGNING_IDENTITY explicitly."
  exit 1
fi
export APPLE_INSTALLER_SIGNING_IDENTITY="$installer_identity"

cd "$project_root"
TAURI_ENV_TARGET_TRIPLE="$target" bun run prepare:macos-bundle
bun run tauri build \
  --target "$target" \
  --config src-tauri/tauri.developer-id.conf.json \
  "$@"
